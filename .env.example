ADMIN_PASSWORD=change-me
PORT=8787
# NAS 对外访问端口；容器内部端口保持 8787。
HOST_PORT=8787
# 本地运行使用 ./data；Compose 会自动覆盖为容器内的 /app/data。
DATA_DIR=./data
PASSWORD_LOCK_MAX_ATTEMPTS=5
PASSWORD_LOCK_MS=86400000
# 保持 0 表示不信任 X-Forwarded-For；仅在受控反向代理后按实际代理层数设置。
TRUST_PROXY_HOPS=0
# 仅检测并刷新 Cookie，不会自动同步笔记。默认每 6 小时检测一次，设为 0 可关闭。
COOKIE_CHECK_INTERVAL_MS=21600000
COOKIE_CHECK_START_DELAY_MS=60000
